# Shared environment for the local-first Axceta stack.
MQTT_HOST=mosquitto
MQTT_PORT=1883
CLOUD_PORT=8000
DASHBOARD_PORT=5173
# Devices are considered online if a sample arrived within this many seconds.
ONLINE_THRESHOLD_SECONDS=5
# Grid stress peak window (local clock of the cloud container).
STRESS_PEAK_START=16:00
STRESS_PEAK_END=20:00
TZ=America/Toronto
